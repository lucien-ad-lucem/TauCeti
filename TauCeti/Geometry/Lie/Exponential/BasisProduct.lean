public import Mathlib.Analysis.Calculus.InverseFunctionTheorem.ContDiff

/-!
# Generation by the one-parameter subgroups of a basis

For a basis `b` of the Lie algebra of a finite-dimensional real Lie group, the ordered product
`t ↦ lieExp (t 0 • b 0) * ⋯ * lieExp (t (n - 1) • b (n - 1))`
of the one-parameter subgroups of the basis vectors (canonical coordinates of the second kind) has,
in the identity chart, derivative `t ↦ ∑ i, t i • b i` at `0`, so by the inverse function theorem
its range is a neighbourhood of the identity.  Hence the one-parameter subgroups of a basis
already generate the identity component, and the whole group when it is preconnected.

## Main definitions

* `lieExpProd`: the ordered product of the exponential lines of a family of Lie-algebra elements.

## Main results

* `hasFDerivAt_extChartAt_lieExpProd_zero`: in the identity chart, the derivative of the product
  at `0` is the coordinate map of the basis.
* `range_lieExpProd_mem_nhds_one`: the range of the product of a basis is a neighbourhood of the
  identity.
* `lieExpProd_mem_closure_iUnion_range_lieExp_smul`: the product lies in the subgroup generated
  by the exponential lines of the family.
* `closure_iUnion_range_lieExp_smul_eq_connectedComponentOfOne`: the one-parameter subgroups of a
  basis generate the identity component.
* `closure_iUnion_range_lieExp_smul_eq_top`: a preconnected Lie group is generated by the
  one-parameter subgroups of a basis of its Lie algebra.

## References

* J. M. Lee, *Introduction to Smooth Manifolds*, 2nd ed., Proposition 7.14 (a connected Lie group
  is generated by any neighbourhood of the identity) and Proposition 20.8 (properties of the
  exponential map, in particular its derivative at `0`).
-/

public section

open Filter Set
open scoped ContDiff Manifold Topology

attribute [local instance] LieGroup.minSmoothnessThree

namespace TauCeti

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [TopologicalSpace G] [ChartedSpace H G] [Group G]
  [FiniteDimensional ℝ E] [LieGroup I ∞ G] [T2Space G] [BoundarylessManifold I G]

/-- The ordered product `lieExp (t 0 • b 0) * ⋯ * lieExp (t (n - 1) • b (n - 1))` of the
exponential lines of a family `b` of Lie-algebra elements, along the coordinates `t`. -/
noncomputable def lieExpProd : ∀ {n : ℕ}, (Fin n → LeftInvariantDerivation I G) → (Fin n → ℝ) → G
  | 0, _, _ => 1
  | _ + 1, b, t => lieExp (t 0 • b 0) * lieExpProd (Fin.tail b) (Fin.tail t)

/-- The recursive step of the product. -/
@[simp]
theorem lieExpProd_succ {n : ℕ} (b : Fin (n + 1) → LeftInvariantDerivation I G)
    (t : Fin (n + 1) → ℝ) :
    lieExpProd (I := I) (G := G) b t = lieExp (t 0 • b 0) * lieExpProd (Fin.tail b) (Fin.tail t) :=
  rfl

@[simp]
theorem lieExpProd_zero : ∀ {n : ℕ} (b : Fin n → LeftInvariantDerivation I G),
    lieExpProd (I := I) (G := G) b 0 = 1
  | 0, _ => rfl
  | n + 1, b => by
    rw [lieExpProd_succ, Pi.zero_apply, zero_smul, lieExp_zero, one_mul]
    exact lieExpProd_zero (Fin.tail b)

private theorem fin_tail_single_succ {n : ℕ} (i : Fin n) (s : ℝ) :
    Fin.tail (Pi.single i.succ s : Fin (n + 1) → ℝ) = Pi.single i s := by
  funext j
  simp [Fin.tail, Pi.single_apply, Fin.succ_inj]

/-- Along a coordinate line, the product is a single exponential line. -/
@[simp]
theorem lieExpProd_single : ∀ {n : ℕ} (b : Fin n → LeftInvariantDerivation I G) (i : Fin n)
    (s : ℝ), lieExpProd (I := I) (G := G) b (Pi.single i s) = lieExp (s • b i)
  | 0, _, i, _ => i.elim0
  | n + 1, b, i, s => by
    induction i using Fin.cases with
    | zero =>
      have ht : Fin.tail (Pi.single (0 : Fin (n + 1)) s : Fin (n + 1) → ℝ) = 0 := by
        funext j
        simp [Fin.tail, Fin.succ_ne_zero]
      rw [lieExpProd_succ, ht, lieExpProd_zero, mul_one, Pi.single_eq_same]
    | succ j =>
      rw [lieExpProd_succ, Pi.single_eq_of_ne (Fin.succ_ne_zero j).symm, zero_smul, lieExp_zero,
        one_mul, fin_tail_single_succ, lieExpProd_single (Fin.tail b) j s]
      rfl

private theorem contMDiff_fin_tail (n : ℕ) :
    ContMDiff 𝓘(ℝ, Fin (n + 1) → ℝ) 𝓘(ℝ, Fin n → ℝ) ∞
      (Fin.tail : (Fin (n + 1) → ℝ) → Fin n → ℝ) :=
  contMDiff_iff_contDiff.mpr (contDiff_pi.mpr fun i ↦ contDiff_apply ℝ ℝ i.succ)

/-- The product of exponential lines is smooth in the coordinates. -/
theorem contMDiff_lieExpProd : ∀ {n : ℕ} (b : Fin n → LeftInvariantDerivation I G),
    ContMDiff 𝓘(ℝ, Fin n → ℝ) I ∞ (lieExpProd (I := I) (G := G) b)
  | 0, _ => contMDiff_const
  | n + 1, b => by
    have hline : ContMDiff 𝓘(ℝ, Fin (n + 1) → ℝ) I ∞
        fun t : Fin (n + 1) → ℝ ↦ lieExp (t 0 • b 0) := by
      have h := (contMDiff_oneParameterSubgroup (I := I) (b 0)).comp
        (contMDiff_iff_contDiff.mpr (contDiff_apply ℝ ℝ (0 : Fin (n + 1))))
      simpa only [Function.comp_def, oneParameterSubgroup_apply] using h
    have htail : ContMDiff 𝓘(ℝ, Fin (n + 1) → ℝ) I ∞
        fun t : Fin (n + 1) → ℝ ↦ lieExpProd (I := I) (G := G) (Fin.tail b) (Fin.tail t) :=
      (contMDiff_lieExpProd (Fin.tail b)).comp (contMDiff_fin_tail n)
    exact hline.mul htail

/-- The product of exponential lines, read in the identity chart, is smooth at `0`. -/
theorem contDiffAt_extChartAt_lieExpProd_zero {n : ℕ} (b : Fin n → LeftInvariantDerivation I G) :
    ContDiffAt ℝ ∞ (fun t ↦ extChartAt I (1 : G) (lieExpProd (I := I) (G := G) b t)) 0 := by
  have hchart : ContMDiffAt I 𝓘(ℝ, E) ∞ (extChartAt I (1 : G))
      (lieExpProd (I := I) (G := G) b 0) := by
    rw [lieExpProd_zero]
    exact contMDiffAt_extChartAt
  exact contMDiffAt_iff_contDiffAt.mp (hchart.comp 0 (contMDiff_lieExpProd b).contMDiffAt)

/-- In the identity chart, the exponential line of `X` has derivative `X` at `0`, read through
the canonical identification of left-invariant derivations with the model space. -/
theorem hasDerivAt_extChartAt_lieExp_smul_zero (X : LeftInvariantDerivation I G) :
    HasDerivAt (fun s : ℝ ↦ extChartAt I (1 : G) (lieExp (s • X)))
      (leftInvariantDerivationLinearIsometryEquivModelVectorSpace (I := I) (G := G) X) 0 := by
  have hscale : HasDerivAt (fun s : ℝ ↦ s • X) X 0 := by
    simpa using (hasDerivAt_id (𝕜 := ℝ) (0 : ℝ)).smul_const X
  exact (hasFDerivAt_extChartAt_lieExp_zero (I := I) (G := G)).comp_hasDerivAt_of_eq 0 hscale
    (by simp)

/-- In the identity chart, the product of the exponential lines of a basis has derivative the
coordinate map `t ↦ ∑ i, t i • b i` at `0`, read through the canonical identification of
left-invariant derivations with the model space. -/
theorem hasFDerivAt_extChartAt_lieExpProd_zero {n : ℕ}
    (b : Module.Basis (Fin n) ℝ (LeftInvariantDerivation I G)) :
    HasFDerivAt (fun t ↦ extChartAt I (1 : G) (lieExpProd (I := I) (G := G) b t))
      ((b.equivFunL.symm.trans (leftInvariantDerivationLinearIsometryEquivModelVectorSpace
        (I := I) (G := G)).toContinuousLinearEquiv : (Fin n → ℝ) ≃L[ℝ] E) :
        (Fin n → ℝ) →L[ℝ] E) 0 := by
  have hdiff := (contDiffAt_extChartAt_lieExpProd_zero (I := I) (G := G) b).differentiableAt
    (by simp)
  refine hdiff.hasFDerivAt.congr_fderiv ?_
  apply ContinuousLinearMap.coe_injective
  apply (Pi.basisFun ℝ (Fin n)).ext
  intro i
  simp only [ContinuousLinearMap.coe_coe, Pi.basisFun_apply]
  have hscale : HasDerivAt (fun s : ℝ ↦ s • (Pi.single i (1 : ℝ) : Fin n → ℝ))
      (Pi.single i (1 : ℝ)) 0 := by
    simpa using (hasDerivAt_id (𝕜 := ℝ) (0 : ℝ)).smul_const (Pi.single i (1 : ℝ) : Fin n → ℝ)
  have hline := hdiff.hasFDerivAt.comp_hasDerivAt_of_eq 0 hscale (by simp)
  have hfun : (fun s : ℝ ↦ extChartAt I (1 : G)
      (lieExpProd (I := I) (G := G) b (s • Pi.single i (1 : ℝ)))) =
      fun s : ℝ ↦ extChartAt I (1 : G) (lieExp (s • b i)) := by
    funext s
    rw [← lieExpProd_single b i s]
    congr 2
    funext j
    simp [Pi.single_apply]
  rw [Function.comp_def, hfun] at hline
  have hb : b.equivFunL.symm (Pi.single i (1 : ℝ)) = b i :=
    (Module.Basis.equivFun_symm_apply b _).trans (by simp [Pi.single_apply])
  rw [hline.unique (hasDerivAt_extChartAt_lieExp_smul_zero (b i)), ContinuousLinearEquiv.coe_coe,
    ContinuousLinearEquiv.trans_apply, hb]
  rfl

/-- **The product of the exponential lines of a basis covers a neighbourhood of the identity.** -/
theorem range_lieExpProd_mem_nhds_one {n : ℕ}
    (b : Module.Basis (Fin n) ℝ (LeftInvariantDerivation I G)) :
    range (lieExpProd (I := I) (G := G) b) ∈ 𝓝 (1 : G) := by
  have hc := contDiffAt_extChartAt_lieExpProd_zero (I := I) (G := G) b
  have hd := hasFDerivAt_extChartAt_lieExpProd_zero (I := I) (G := G) b
  set ψ := hc.toOpenPartialHomeomorph
    (fun t ↦ extChartAt I (1 : G) (lieExpProd (I := I) (G := G) b t)) hd (by simp)
  have h0 : (0 : Fin n → ℝ) ∈ ψ.source := hc.mem_toOpenPartialHomeomorph_source hd (by simp)
  have hcoe : (ψ : (Fin n → ℝ) → E) =
      fun t ↦ extChartAt I (1 : G) (lieExpProd (I := I) (G := G) b t) :=
    hc.toOpenPartialHomeomorph_coe hd (by simp)
  have hψ0 : ψ 0 = extChartAt I (1 : G) (1 : G) := by
    rw [hcoe]
    simp only [lieExpProd_zero]
  have htarget : ψ.target ∈ 𝓝 (extChartAt I (1 : G) (1 : G)) := by
    rw [← hψ0]
    exact ψ.open_target.mem_nhds (ψ.map_source h0)
  have hchart : ∀ᶠ g in 𝓝 (1 : G), extChartAt I (1 : G) g ∈ ψ.target :=
    (continuousAt_extChartAt (I := I) (1 : G)).preimage_mem_nhds htarget
  have hsymm : ψ.symm (extChartAt I (1 : G) (1 : G)) = 0 := by
    rw [← hψ0]
    exact ψ.left_inv h0
  have hcont : ContinuousAt
      (fun g : G ↦ lieExpProd (I := I) (G := G) b (ψ.symm (extChartAt I (1 : G) g))) 1 :=
    (contMDiff_lieExpProd b).continuous.continuousAt.comp_of_eq
      ((ψ.continuousAt_symm (by rw [← hψ0]; exact ψ.map_source h0)).comp
        (continuousAt_extChartAt (I := I) (1 : G))) hsymm
  have hone : lieExpProd (I := I) (G := G) b (ψ.symm (extChartAt I (1 : G) (1 : G))) = 1 := by
    rw [hsymm, lieExpProd_zero]
  have hsource : ∀ᶠ g in 𝓝 (1 : G),
      lieExpProd (I := I) (G := G) b (ψ.symm (extChartAt I (1 : G) g)) ∈
        (extChartAt I (1 : G)).source :=
    hcont.preimage_mem_nhds (by rw [hone]; exact extChartAt_source_mem_nhds (I := I) (1 : G))
  filter_upwards [hchart, hsource, extChartAt_source_mem_nhds (I := I) (1 : G)] with g hg hp hgs
  refine ⟨ψ.symm (extChartAt I (1 : G) g), (extChartAt I (1 : G)).injOn hp hgs ?_⟩
  have h := ψ.right_inv hg
  rw [hcoe] at h
  exact h

/-- The product of exponential lines lies in the subgroup generated by the exponential lines. -/
theorem lieExpProd_mem_closure_iUnion_range_lieExp_smul :
    ∀ {n : ℕ} (b : Fin n → LeftInvariantDerivation I G) (t : Fin n → ℝ),
      lieExpProd (I := I) (G := G) b t ∈
        Subgroup.closure (⋃ i, range fun s : ℝ ↦ lieExp (s • b i))
  | 0, _, _ => one_mem _
  | n + 1, b, t => by
    rw [lieExpProd_succ]
    refine mul_mem (Subgroup.subset_closure (mem_iUnion.mpr ⟨0, t 0, rfl⟩)) ?_
    refine Subgroup.closure_mono ?_
      (lieExpProd_mem_closure_iUnion_range_lieExp_smul (Fin.tail b) (Fin.tail t))
    rintro _ ⟨_, ⟨j, rfl⟩, hx⟩
    exact mem_iUnion.mpr ⟨j.succ, hx⟩

variable [IsTopologicalGroup G]

/-- **The one-parameter subgroups of a basis generate the identity component.** -/
theorem closure_iUnion_range_lieExp_smul_eq_connectedComponentOfOne {n : ℕ}
    (b : Module.Basis (Fin n) ℝ (LeftInvariantDerivation I G)) :
    Subgroup.closure (⋃ i, range fun s : ℝ ↦ lieExp (s • b i)) =
      Subgroup.connectedComponentOfOne G := by
  refine le_antisymm ((Subgroup.closure_le _).mpr ?_)
    (Subgroup.connectedComponentOfOne_le_of_mem_nhds_one
      (Filter.mem_of_superset (range_lieExpProd_mem_nhds_one b)
        (range_subset_iff.mpr fun t ↦ lieExpProd_mem_closure_iUnion_range_lieExp_smul b t)))
  rintro _ ⟨_, ⟨i, rfl⟩, s, rfl⟩
  exact lieExp_mem_connectedComponent_one _

/-- **A preconnected Lie group is generated by the one-parameter subgroups of a basis of its Lie
algebra.** -/
theorem closure_iUnion_range_lieExp_smul_eq_top [PreconnectedSpace G] {n : ℕ}
    (b : Module.Basis (Fin n) ℝ (LeftInvariantDerivation I G)) :
    Subgroup.closure (⋃ i, range fun s : ℝ ↦ lieExp (s • b i)) = ⊤ := by
  rw [closure_iUnion_range_lieExp_smul_eq_connectedComponentOfOne,
    Subgroup.connectedComponentOfOne_eq_top]

end TauCeti
